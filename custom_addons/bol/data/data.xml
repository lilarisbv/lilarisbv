<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="bol_delivery" model="product.product">
            <field name="name">Bol.com Delivery</field>
            <field name="type">service</field>
            <field name="default_code">bol_delivery</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="invoice_policy">order</field>
        </record>

        <!-- One cron for every Bol.com instance (no mk_instance_id, so not listed in an instance's Automatic Jobs tab). -->
        <record id="bol_check_pending_process_status" model="ir.cron">
            <field name="name">Bol.com : Check Pending Process Status</field>
            <field name="model_id" ref="model_bol_process_status"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_pending_process_status()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="res_partner_category_bol" model="res.partner.category">
            <field name="name">Bol.com</field>
            <field name="color" eval="4"/>
        </record>
    </data>
</odoo>

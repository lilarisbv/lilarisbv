#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Approved]:</b> The request has been approved."
msgstr "<b>[Approuvé]:</b> La demande a été approuvée."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Cancelled]:</b> The request has been cancelled."
msgstr "<b>[Annulé]:</b> La demande a été annulée."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Change Requested]:</b> Changes requested for this ticket."
msgstr "<b>[Modification demandée]:</b> Des modifications ont été demandées pour ce ticket."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[Delivered]:</b> Your request has been delivered. Please review the "
"solution and confirm."
msgstr ""
"<b>[Livré]:</b> Votre demande a été livrée. Veuillez vérifier la solution"
"et confirmer."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[In Progress]:</b> Our development team has started working on your "
"request."
msgstr ""
"<b>[En cours de traitement]:</b> Notre équipe de développement a commencé à travailler sur votre demande."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[New]:</b> Your request has been received."
msgstr "<b>[Nouveau]:</b> Votre demande a été reçue."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[On Hold]:</b> This ticket is on hold. Awaiting further info/action from "
"your side."
msgstr ""
"<b>[En attente]:</b> Ce ticket est en attente. En attente d'informations/actions de votre part."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Queued]:</b> Your request has been reviewed and scheduled."
msgstr "<b>[En file d'attente]:</b> Votre demande a été examinée et planifiée"

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[Under Review]:</b> We are currently evaluating the feasibility/"
"optimization of this request."
msgstr ""
"<b>[En cours de révision]:</b>Nous évaluons actuellement la faisabilité/"
"l'optimisation de cette demande."

#. module: customer_ticket
#: model:mail.template,body_html:customer_ticket.email_template_ticket_delivery
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: "
"#333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; "
"padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #5cb85c; margin-top: 0;\">Solution "
"Delivered!</h2>\n"
"                <p>Dear <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                Great news! The development/solution for your ticket "
"<strong><t t-out=\"object.ticket_number\"/> - <t t-out=\"object.name\"/></"
"strong> has been completed and delivered.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #d9edf7; border: 1px solid "
"#bce8f1; padding: 12px; border-radius: 4px; margin: 15px 0; color: #31708f;"
"\">\n"
"                    <strong>Delivery Notes:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'The solution "
"is ready for your review.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Please review the deployed solution. If everything works "
"perfectly, you can approve and close the ticket from your portal.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/"
"web#id=%s&amp;model=customer.ticket&amp;view_type=form' % "
"(object.env['ir.config_parameter'].sudo().get_param('web.base.url'), "
"object.id)\" style=\"background-color: #5cb85c; color: white; padding: 10px "
"20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: "
"inline-block;\">\n"
"                        Review &amp; Approve Solution\n"
"                    </a>\n"
"                </div>\n"
"\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Need a "
"meeting to review the solution? You can book an appointment with your "
"contact person directly:</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-"
"href=\"object.contact_person_calendar_link\" style=\"background-color: "
"#337ab7; color: white; padding: 8px 15px; text-decoration: none; border-"
"radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Book a Review Meeting\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: "
"#333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; "
"padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #5cb85c; margin-top: 0;\">Solution "
"Livrée !</h2>\n"
"                <p>Bonjour <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                Bonne nouvelle ! Le développement/la solution pour votre "
"ticket <strong><t t-out=\"object.ticket_number\"/> - <t t-"
"out=\"object.name\"/></strong> a été finalisé et livré.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #d9edf7; border: 1px solid "
"#bce8f1; padding: 12px; border-radius: 4px; margin: 15px 0; color: #31708f;"
"\">\n"
"                    <strong>Notes de Livraison :</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'La solution "
"est prête pour votre révision.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Veuillez examiner la solution déployée. Si tout "
"fonctionne parfaitement, vous pouvez approuver et fermer le ticket depuis "
"votre portail.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/"
"web#id=%s&amp;model=customer.ticket&amp;view_type=form' % "
"(object.env['ir.config_parameter'].sudo().get_param('web.base.url'), "
"object.id)\" style=\"background-color: #5cb85c; color: white; padding: 10px "
"20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: "
"inline-block;\">\n"
"                        Examiner &amp; Approuver la Solution\n"
"                    </a>\n"
"                </div>\n"
"\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Besoin "
"d'une réunion pour examiner la solution ? Vous pouvez planifier un rendez-"
"vous directement avec votre interlocuteur :</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-"
"href=\"object.contact_person_calendar_link\" style=\"background-color: "
"#337ab7; color: white; padding: 8px 15px; text-decoration: none; border-"
"radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Réserver une Réunion de Révision\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "

#. module: customer_ticket
#: model:mail.template,body_html:customer_ticket.email_template_ticket_on_hold
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: "
"#333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; "
"padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #d9534f; margin-top: 0;\">Ticket On Hold</"
"h2>\n"
"                <p>Dear <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                    Your ticket <strong><t t-out=\"object.ticket_number\"/> "
"- <t t-out=\"object.name\"/></strong> has been placed <strong>On Hold</"
"strong> by our technical team.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #fcf8e3; border: 1px solid "
"#faebcc; padding: 12px; border-radius: 4px; margin: 15px 0; color: #8a6d3b;"
"\">\n"
"                    <strong>Reason / Message from Team:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'Awaiting "
"further information from your side.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Please review the request and provide the necessary "
"details so we can resume our work.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/"
"web#id=%s&amp;model=customer.ticket&amp;view_type=form' % "
"(object.env['ir.config_parameter'].sudo().get_param('web.base.url'), "
"object.id)\" style=\"background-color: #714B67; color: white; padding: 10px "
"20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: "
"inline-block;\">\n"
"                        View Ticket Details\n"
"                    </a>\n"
"                </div>\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Need a "
"meeting? You can book an appointment with your contact person directly:</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-"
"href=\"object.contact_person_calendar_link\" style=\"background-color: "
"#337ab7; color: white; padding: 8px 15px; text-decoration: none; border-"
"radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Book a Review Meeting\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: "
"#333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; "
"padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #d9534f; margin-top: 0;\">Ticket En "
"Attente</h2>\n"
"                <p>Bonjour  <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                    Votre ticket <strong><t t-out=\"object.ticket_number\"/> "
"- <t t-out=\"object.name\"/></strong> a été mis <strong>En Attente</strong> "
"par notre équipe technique.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #fcf8e3; border: 1px solid "
"#faebcc; padding: 12px; border-radius: 4px; margin: 15px 0; color: #8a6d3b;"
"\">\n"
"                    <strong>Motif / Message de l'Équipe:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'En attente "
"d'informations complémentaires de votre part.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Veuillez examiner la demande et fournir les détails "
"nécessaires afin que nous puissions reprendre notre travail.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/"
"web#id=%s&amp;model=customer.ticket&amp;view_type=form' % "
"(object.env['ir.config_parameter'].sudo().get_param('web.base.url'), "
"object.id)\" style=\"background-color: #714B67; color: white; padding: 10px "
"20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: "
"inline-block;\">\n"
"                        Voir les Détails du Ticket\n"
"                    </a>\n"
"                </div>\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Besoin "
"d'une réunion ? Vous pouvez planifier un rendez-vous directement avec votre "
"interlocuteur :</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-"
"href=\"object.contact_person_calendar_link\" style=\"background-color: "
"#337ab7; color: white; padding: 8px 15px; text-decoration: none; border-"
"radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Réserver une Réunion\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "


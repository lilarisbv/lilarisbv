#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Approved]:</b> The request has been approved."
msgstr "<b>[Goedgekeurd]:</b> Het verzoek is goedgekeurd."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Cancelled]:</b> The request has been cancelled."
msgstr "<b>[Geannuleerd]:</b> Het verzoek is geannuleerd."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Change Requested]:</b> Changes requested for this ticket."
msgstr "<b>[Wijziging aangevraagd]:</b> Wijzigingen aangevraagd voor dit ticket."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[Delivered]:</b> Your request has been delivered. Please review the "
"solution and confirm."
msgstr ""
"<b>[Geleverd]:</b> Uw verzoek is opgeleverd. Controleer de oplossing en "
"bevestig deze."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[In Progress]:</b> Our development team has started working on your "
"request."
msgstr ""
"<b>[In behandeling]:</b> Ons ontwikkelingsteam is begonnen met de verwerking van uw verzoek."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[New]:</b> Your request has been received."
msgstr "<b>[Nieuw]:</b> Uw verzoek is ontvangen."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[On Hold]:</b> This ticket is on hold. Awaiting further info/action from "
"your side."
msgstr ""
"<b>[In wacht]:</b> Dit ticket staat in de wacht. In afwachting van verdere informatie/actie van uw kant."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Queued]:</b> Your request has been reviewed and scheduled."
msgstr "<b>[In wachtrij]:</b> Uw verzoek is beoordeeld en ingepland."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[Under Review]:</b> We are currently evaluating the feasibility/"
"optimization of this request."
msgstr ""
"<b>[In beoordeling]:</b>We evalueren momenteel de haalbaarheid/optimalisatie"
"van dit verzoek."


#. module: customer_ticket
#: model:mail.template,body_html:customer_ticket.email_template_ticket_delivery
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #5cb85c; margin-top: 0;\">Solution Delivered!</h2>\n"
"                <p>Dear <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                Great news! The development/solution for your ticket <strong><t t-out=\"object.ticket_number\"/> - <t t-out=\"object.name\"/></strong> has been completed and delivered.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #d9edf7; border: 1px solid #bce8f1; padding: 12px; border-radius: 4px; margin: 15px 0; color: #31708f;\">\n"
"                    <strong>Delivery Notes:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'The solution is ready for your review.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Please review the deployed solution. If everything works perfectly, you can approve and close the ticket from your portal.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/web#id=%s&amp;model=customer.ticket&amp;view_type=form' % (object.env['ir.config_parameter'].sudo().get_param('web.base.url'), object.id)\" style=\"background-color: #5cb85c; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;\">\n"
"                        Review &amp; Approve Solution\n"
"                    </a>\n"
"                </div>\n"
"\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Need a meeting to review the solution? You can book an appointment with your contact person directly:</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-href=\"object.contact_person_calendar_link\" style=\"background-color: #337ab7; color: white; padding: 8px 15px; text-decoration: none; border-radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Book a Review Meeting\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #5cb85c; margin-top: 0;\">Oplossing Geleverd!</h2>\n"
"                <p>Beste <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                Goed nieuws! De ontwikkeling/oplossing voor uw ticket <strong><t t-out=\"object.ticket_number\"/> - <t t-out=\"object.name\"/></strong> is voltooid en opgeleverd.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #d9edf7; border: 1px solid #bce8f1; padding: 12px; border-radius: 4px; margin: 15px 0; color: #31708f;\">\n"
"                    <strong>Opleveringsnotities:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'De oplossing staat klaar voor uw beoordeling.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Gelieve de geïmplementeerde oplossing te controleren. Als alles perfect werkt, kunt u het ticket goedkeuren en sluiten via uw portaal.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/web#id=%s&amp;model=customer.ticket&amp;view_type=form' % (object.env['ir.config_parameter'].sudo().get_param('web.base.url'), object.id)\" style=\"background-color: #5cb85c; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;\">\n"
"                        Oplossing Beoordelen &amp; Goedkeuren\n"
"                    </a>\n"
"                </div>\n"
"\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Heeft u een vergadering nodig om de oplossing te bespreken? U kunt rechtstreeks een afspraak maken met uw contactpersoon:</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-href=\"object.contact_person_calendar_link\" style=\"background-color: #337ab7; color: white; padding: 8px 15px; text-decoration: none; border-radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Boek een Beoordelingsgesprek\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "

#. module: customer_ticket
#: model:mail.template,body_html:customer_ticket.email_template_ticket_on_hold
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #d9534f; margin-top: 0;\">Ticket On Hold</h2>\n"
"                <p>Dear <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                    Your ticket <strong><t t-out=\"object.ticket_number\"/> - <t t-out=\"object.name\"/></strong> has been placed <strong>On Hold</strong> by our technical team.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #fcf8e3; border: 1px solid #faebcc; padding: 12px; border-radius: 4px; margin: 15px 0; color: #8a6d3b;\">\n"
"                    <strong>Reason / Message from Team:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'Awaiting further information from your side.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Please review the request and provide the necessary details so we can resume our work.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/web#id=%s&amp;model=customer.ticket&amp;view_type=form' % (object.env['ir.config_parameter'].sudo().get_param('web.base.url'), object.id)\" style=\"background-color: #714B67; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;\">\n"
"                        View Ticket Details\n"
"                    </a>\n"
"                </div>\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Need a meeting? You can book an appointment with your contact person directly:</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-href=\"object.contact_person_calendar_link\" style=\"background-color: #337ab7; color: white; padding: 8px 15px; text-decoration: none; border-radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Book a Review Meeting\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #d9534f; margin-top: 0;\">Ticket In Wacht</h2>\n"
"                <p>Beste <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                    Uw ticket <strong><t t-out=\"object.ticket_number\"/> - <t t-out=\"object.name\"/></strong> werd door ons technisch team <strong>In Wacht</strong> geplaatst.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #fcf8e3; border: 1px solid #faebcc; padding: 12px; border-radius: 4px; margin: 15px 0; color: #8a6d3b;\">\n"
"                    <strong>Reden / Bericht van het Team:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'In afwachting van verdere informatie van uw kant.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Gelieve de aanvraag te bekijken en de nodige details te bezorgen, zodat we ons werk kunnen hervatten.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/web#id=%s&amp;model=customer.ticket&amp;view_type=form' % (object.env['ir.config_parameter'].sudo().get_param('web.base.url'), object.id)\" style=\"background-color: #714B67; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;\">\n"
"                        Bekijk Ticketdetails\n"
"                    </a>\n"
"                </div>\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Een vergadering nodig? U kunt rechtstreeks een afspraak boeken met uw contactpersoon:</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-href=\"object.contact_person_calendar_link\" style=\"background-color: #337ab7; color: white; padding: 8px 15px; text-decoration: none; border-radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Boek een gesprek\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "


#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Approved]:</b> The request has been approved."
msgstr "<b>[Onaylandı]:</b> Talep onaylandı ve kapatıldı."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Cancelled]:</b> The request has been cancelled."
msgstr "<b>[İptal Edildi]:</b> Talep iptal edildi."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Change Requested]:</b> Changes requested for this ticket."
msgstr "<b>[Değişiklik Talebi]:</b> Bu talep için değişiklik talep edildi."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[Delivered]:</b> Your request has been delivered. Please review the "
"solution and confirm."
msgstr ""
"<b>[Çözüldü]:</b> Talebiniz çözüme ulaştı. Lütfen çözümü inceleyin ve "
"onaylayın."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[In Progress]:</b> Our development team has started working on your "
"request."
msgstr ""
"<b>[İşlemde]:</b> Geliştirme ekibimiz talebiniz üzerinde çalışmaya başladı."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[New]:</b> Your request has been received."
msgstr "<b>[Yeni]:</b> Talebiniz alındı."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[On Hold]:</b> This ticket is on hold. Awaiting further info/action from "
"your side."
msgstr ""
"<b>[Beklemede]:</b> Bu talep beklemede. Sizden bilgi veya işlem bekleniyor."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid "<b>[Queued]:</b> Your request has been reviewed and scheduled."
msgstr "<b>[Sırada]:</b> Talebiniz incelendi ve planlandı."

#. module: customer_ticket
#: model_terms:ir.ui.view,arch_db:customer_ticket.view_customer_ticket_help_form
msgid ""
"<b>[Under Review]:</b> We are currently evaluating the feasibility/"
"optimization of this request."
msgstr ""
"<b>[İncelemede]:</b>Bu talebinizin uygulanabilirliğini/optimizasyonunu "
"değerlendiriyoruz."

#. module: customer_ticket
#: model:mail.template,body_html:customer_ticket.email_template_ticket_delivery
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: "
"#333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; "
"padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #5cb85c; margin-top: 0;\">Solution "
"Delivered!</h2>\n"
"                <p>Dear <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                Great news! The development/solution for your ticket "
"<strong><t t-out=\"object.ticket_number\"/> - <t t-out=\"object.name\"/></"
"strong> has been completed and delivered.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #d9edf7; border: 1px solid "
"#bce8f1; padding: 12px; border-radius: 4px; margin: 15px 0; color: #31708f;"
"\">\n"
"                    <strong>Delivery Notes:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'The solution "
"is ready for your review.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Please review the deployed solution. If everything works "
"perfectly, you can approve and close the ticket from your portal.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/"
"web#id=%s&amp;model=customer.ticket&amp;view_type=form' % "
"(object.env['ir.config_parameter'].sudo().get_param('web.base.url'), "
"object.id)\" style=\"background-color: #5cb85c; color: white; padding: 10px "
"20px; text-decoration: none; border-radius: 4px; font-weight: bold; "
"display: inline-block;\">\n"
"                        Review &amp; Approve Solution\n"
"                    </a>\n"
"                </div>\n"
"\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Need a "
"meeting to review the solution? You can book an appointment with your "
"contact person directly:</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-"
"href=\"object.contact_person_calendar_link\" style=\"background-color: "
"#337ab7; color: white; padding: 8px 15px; text-decoration: none; border-"
"radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Book a Review Meeting\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: "
"#333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; "
"padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #5cb85c; margin-top: 0;\">Çözüm Hazır!</"
"h2>\n"
"                <p>Sayın <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                <strong><t t-out=\"object.ticket_number\"/> numaralı  <t t-"
"out=\"object.name\"/></strong> talebiniz için geliştirme/çözüm tamamlandı "
"ve teslim edildi.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #d9edf7; border: 1px solid "
"#bce8f1; padding: 12px; border-radius: 4px; margin: 15px 0; color: #31708f;"
"\">\n"
"                    <strong>Teslimat Notları:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'Çözüm "
"incelemeniz için hazır.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Lütfen canlıya alınan çözümü inceleyin. Her şey mükemmel "
"çalışıyorsa, portalınızdan talebi onaylayabilir ve kapatabilirsiniz.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/"
"web#id=%s&amp;model=customer.ticket&amp;view_type=form' % "
"(object.env['ir.config_parameter'].sudo().get_param('web.base.url'), "
"object.id)\" style=\"background-color: #5cb85c; color: white; padding: 10px "
"20px; text-decoration: none; border-radius: 4px; font-weight: bold; "
"display: inline-block;\">\n"
"                        Çözümü İncele &amp; Onayla\n"
"                    </a>\n"
"                </div>\n"
"\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Çözümü "
"incelemek için bir toplantıya mı ihtiyacınız var? Doğrudan ilgili kişiyle "
"bir randevu planlayabilirsiniz:</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-"
"href=\"object.contact_person_calendar_link\" style=\"background-color: "
"#337ab7; color: white; padding: 8px 15px; text-decoration: none; border-"
"radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Toplantı Ayarla\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "

#. module: customer_ticket
#: model:mail.template,body_html:customer_ticket.email_template_ticket_on_hold
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: "
"#333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; "
"padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #d9534f; margin-top: 0;\">Ticket On "
"Hold</h2>\n"
"                <p>Dear <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                    Your ticket <strong><t t-out=\"object.ticket_number\"/> "

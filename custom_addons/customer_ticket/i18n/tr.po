"further information from your side.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Please review the request and provide the necessary "
"details so we can resume our work.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/"
"web#id=%s&amp;model=customer.ticket&amp;view_type=form' % "
"(object.env['ir.config_parameter'].sudo().get_param('web.base.url'), "
"object.id)\" style=\"background-color: #714B67; color: white; padding: 10px "
"20px; text-decoration: none; border-radius: 4px; font-weight: bold; "
"display: inline-block;\">\n"
"                        View Ticket Details\n"
"                    </a>\n"
"                </div>\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;\">Need a "
"meeting? You can book an appointment with your contact person directly:</"
"p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-"
"href=\"object.contact_person_calendar_link\" style=\"background-color: "
"#337ab7; color: white; padding: 8px 15px; text-decoration: none; border-"
"radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Book a Review Meeting\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: "
"#333333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; "
"padding: 20px; border-radius: 7px;\">\n"
"                <h2 style=\"color: #d9534f; margin-top: 0;\">Talep "
"Beklemede</h2>\n"
"                <p>Sayın <t t-out=\"object.create_uid.name\"/>,</p>\n"
"                <p>\n"
"                <strong><t t-out=\"object.ticket_number\"/> numaralı <t t-"
"out=\"object.name\"/></strong> talebiniz teknik ekip tarafından "
"<strong>Bekleme</strong>ye alınmıştır.\n"
"                </p>\n"
"\n"
"                <div style=\"background-color: #fcf8e3; border: 1px solid "
"#faebcc; padding: 12px; border-radius: 4px; margin: 15px 0; color: #8a6d3b;"
"\">\n"
"                    <strong>Nedeni / Ekip Mesajı:</strong><br/>\n"
"                    <t t-out=\"object.confirmation_status or 'Sizden "
"gelecek ek bilgiler beklenmektedir.'\"/>\n"
"                </div>\n"
"\n"
"                <p>Lütfen talebi inceleyin ve çalışmamıza devam edebilmemiz "
"için gerekli ayrıntıları sağlayın.</p>\n"
"\n"
"                <div style=\"margin: 25px 0; text-align: center;\">\n"
"                    <a t-att-href=\"'%s/"
"web#id=%s&amp;model=customer.ticket&amp;view_type=form' % "
"(object.env['ir.config_parameter'].sudo().get_param('web.base.url'), "
"object.id)\" style=\"background-color: #714B67; color: white; padding: 10px "
"20px; text-decoration: none; border-radius: 4px; font-weight: bold; "
"display: inline-block;\">\n"
"                        Talep Detaylarını Görüntüle\n"
"                    </a>\n"
"                </div>\n"
"                <t t-if=\"object.contact_person_calendar_link\">\n"
"                    <p style=\"margin-top: 20px; font-size: 13px;"
"\">Toplantıya mı ihtiyacınız var? Doğrudan ilgili kişiyle bir randevu "
"planlayabilirsiniz:</p>\n"
"                    <div style=\"text-align: center; margin: 15px 0;\">\n"
"                        <a t-att-"
"href=\"object.contact_person_calendar_link\" style=\"background-color: "
"#337ab7; color: white; padding: 8px 15px; text-decoration: none; border-"
"radius: 4px; font-size: 13px; display: inline-block;\">\n"
"                            Toplantı Ayarla\n"
"                        </a>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "


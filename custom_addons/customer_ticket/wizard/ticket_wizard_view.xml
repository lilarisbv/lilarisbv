<odoo>
    <record id="view_customer_ticket_wizard_form" model="ir.ui.view">
        <field name="name">customer.ticket.wizard.form</field>
        <field name="model">customer.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Ticket Action">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <field name="instruction" readonly="1"/>
                    </div>
                    <group>
                        <field name="reason" placeholder="Type here..." nolabel="1" rows="4"/>
                        <field name="ticket_id" invisible="1"/>
                        <field name="action_type" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
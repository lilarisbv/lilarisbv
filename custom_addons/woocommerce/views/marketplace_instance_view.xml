<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="woocommerce_marketplace_instance_form_view" model="ir.ui.view">
            <field name="name">woocommerce.marketplace.instance.form</field>
            <field name="model">mk.instance</field>
            <field name="inherit_id" ref="base_marketplace.marketplace_instance_form_view"/>
            <field name="arch" type="xml">
                <page name="credentials" position="inside">
                    <div class="row mt16 o_settings_container" invisible="marketplace != 'woocommerce'">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label string="Consumer Key" for="woo_consumer_key"/>
                                <div class="text-muted">
                                    Consumer key used for authentication.
                                </div>
                                <div class="text-muted">
                                    <b>
                                        <field name="woo_consumer_key" required="marketplace == 'woocommerce'" readonly="state == 'confirmed'"/>
                                    </b>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label string="Consumer Secret" for="woo_consumer_secret"/>
                                <div class="text-muted">
                                    Consumer Secret used for authentication.
                                </div>
                                <div class="text-muted">
                                    <b>
                                        <field name="woo_consumer_secret" password="True" required="marketplace == 'woocommerce'" readonly="state == 'confirmed'"/>
                                    </b>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label string="Shop URL" for="woo_shop_url"/>
                                <div class="text-muted">
                                    Shop URL used for authentication (Exp. https://teqstars.mywoocommerce.com).
                                </div>
                                <div class="text-muted">
                                    <b>
                                        <field name="woo_shop_url" required="marketplace == 'woocommerce'" readonly="state == 'confirmed'"/>
                                    </b>
                                </div>
                            </div>
                        </div>
                    </div>
                </page>
                <xpath expr="//page[@name='order_config']//div[hasclass('o_settings_container')][last()]" position="inside">
                    <div class="col-xs-12 col-md-6 o_setting_box" invisible="marketplace != 'woocommerce'">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label string="Order Status" for="woo_order_status_ids"/>
                            <div class="text-muted">
                                Filter orders by their fulfillment status at the time of Import Orders.
                            </div>
                            <div class="text-muted">
                                <b>
                                    <field name="woo_order_status_ids" widget="many2many_tags" required="marketplace == 'woocommerce'"
                                           options="{'no_create' : True}"/>
                                </b>
                            </div>
                        </div>
                    </div>
                </xpath>
                <xpath expr="//page[@name='customer_config']//div[hasclass('o_settings_container')][last()]" position="inside">
                    <div class="col-xs-12 col-md-6 o_setting_box" invisible="marketplace != 'woocommerce'">
                        <div class="o_setting_left_pane">
                            <b>
                                <field name="is_create_company_contact_woo"/>
                            </b>
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="Create Company Contact?" for="is_create_company_contact_woo"/>
                            <div class="text-muted">
                                Create company contact if found company while creating Contact.
                            </div>
                        </div>
                    </div>
                </xpath>
                <page name="workflow_config" position="inside">
                    <field name="woo_order_workflow_config_ids" invisible="marketplace != 'woocommerce'">
                        <list editable="bottom">
                            <field name="payment_term_id" required="1"/>
                            <field name="order_workflow_id" required="1"/>
                            <field name="mk_instance_id" column_invisible="1"/>
                            <field name="payment_gateway_id" domain="[('mk_instance_id', '=', parent.id)]" required="1" options="{'no_create_edit': True}"/>
                            <field name="order_status" required="1"/>
                        </list>
                    </field>
                </page>
                <page name="workflow_config" position="after">
                    <page name="webhook_config" string="Webhook" invisible="marketplace != 'woocommerce'">
                        <div class="alert alert-info info_icon pull-left" role="alert">
                            <span class="fa fa-lightbulb-o fa-lg">
                            </span>
                            &amp;nbsp;Webhook URL for this Instance:
                            <strong>
                                <field name="woo_webhook_url" readonly="1"/>
                            </strong>
                            <br/>
                            <span>If you are removed any webhook operation here, it will also remove it from wooCommerce.</span>
                        </div>
                        <button type="object" class="oe_right btn btn-primary" name="fetch_woo_webhook" icon="fa-cogs" string="Fetch Webhook"/>
                        <br/>
                        <field name="woo_webhook_ids">
                            <list editable="bottom">
                                <field name="name" required="1"/>
                                <field name="webhook_event" required="1"/>
                                <field name="active_webhook" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </page>
                </page>
                <xpath expr="//page[@name='configuration']//div[hasclass('o_settings_container')][last()]" position="inside">
                    <div class="col-xs-12 col-md-6 o_setting_box" id="woo_weight_uom_id" name="woo_weight_uom_id" invisible="marketplace != 'woocommerce'">
                        <div class="o_setting_right_pane">
                            <label string="Weight Unit" for="woo_weight_uom_id"/>
                            <div class="text-muted">
                                This controls what unit you will define weights in.
                            </div>
                            <div class="text-muted">
                                <b>
                                    <field name="woo_weight_uom_id" options="{'no_create' : True}" readonly="state == 'confirmed'"/>
                                </b>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box" id="woo_store_tz" name="woo_store_tz" invisible="marketplace != 'woocommerce'">
                        <div class="o_setting_right_pane">
                            <label string="Store Timezone" for="woo_store_tz"/>
                            <div class="text-muted">
                                WooCommerce Store Timezone
                            </div>
                            <div class="text-muted">
                                <b>
                                    <field name="woo_store_tz" readonly="state == 'confirmed'" required="marketplace == 'woocommerce'"/>
                                </b>
                            </div>
                        </div>
                    </div>
                </xpath>
                <xpath expr="//div[@name='is_update_odoo_product_category']/div[hasclass('o_setting_right_pane')]" position="inside">
                    <div class="text-muted" invisible="marketplace != 'woocommerce'">
                        If an Odoo product category exists with the same name as in WooCommerce.
                    </div>
                </xpath>
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="%(woocommerce.action_woocommerce_product_category_instance)d" type="action"
                            icon="fa-list-alt" class="oe_stat_button" invisible="woo_product_category_count &lt;= 0">
                        <field string="Categories" name="woo_product_category_count" widget="statinfo"/>
                    </button>
                    <button name="%(woocommerce.action_woocommerce_product_tag_instance)d" type="action"
                            icon="fa-tag" class="oe_stat_button" invisible="woo_product_tag_count &lt;= 0">
                        <field string="Tags" name="woo_product_tag_count" widget="statinfo"/>
                    </button>
                </xpath>
                <xpath expr="//div[@name='delivery_product_id']" position="after">
                    <div class="col-xs-12 col-md-6 o_setting_box" invisible="marketplace != 'woocommerce'" groups="base.group_no_one">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="woocommerce_fees_product_id"/>
                            <div class="text-muted">
                                WooCommerce order with having fees item will be imported with this product in order (Only Service type product).
                            </div>
                            <div class="text-muted">
                                <b>
                                    <field name="woocommerce_fees_product_id" required="marketplace == 'woocommerce'" options="{'no_quick_create':True,'no_create_edit':True}"/>
                                </b>
                            </div>
                        </div>
                    </div>
                </xpath>
                <page name="notification_config" position="after">
                    <page name="custom_fields_config" string="Custom Fields Mapping" invisible="marketplace != 'woocommerce'">
                        <div class="alert alert-warning" role="alert">
                            <h3>Note:</h3>
                            <ol>
                                <li>If you have configured custom field mapping and set a field based on a custom field name (Meta Key), it will override the existing field value in the Odoo record.</li>
                                <li>If you need to synchronize Date or DateTime fields in Odoo using custom field, the values will be formatted based on the provided field date format and time format.</li>
                                <li>If you have configured custom field mapping, it will synchronize the custom field metadata only for newly created records.</li>
                            </ol>
                        </div>
                        <br/>
                        <div>
                            <field name="custom_field_mapping_ids" nolabel="1" mode="list">
                                <list editable="bottom">
                                    <field name="woo_custom_key" required="1"/>
                                    <field name="woo_operation" required="1"/>
                                    <field name="model_id" options="{'no_open':True,'no_create':True,'no_create_edit': True}" required="1"/>
                                    <field name="field_id" domain="[('model_id','=',model_id),('ttype', 'not in',['many2one','many2many','one2many','binary'])]" options="{'no_open':True,'no_create':True,'no_create_edit': True}" required="1"/>
                                    <field name="field_type" column_invisible="1"/>
                                    <field name="date_format" placeholder="%m/%d/%Y" readonly="field_type not in ('datetime','date')"/>
                                    <field name="time_format" placeholder="%H:%M:%S" readonly="field_type not in ('datetime')"/>
                                </list>
                            </field>
                        </div>
<!--                        &lt;!&ndash; Legends for supported Date and Time Formats &ndash;&gt;-->

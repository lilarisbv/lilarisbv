<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="woocommerce_payment_gateway_form_view" model="ir.ui.view">
            <field name="name">woocommerce_payment_gateway_form_view</field>
            <field name="model">woo.payment.gateway.ts</field>
            <field name="arch" type="xml">
                <form string="WooCommerce Payment Gateway">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="WooCommerce Payment Gateway Name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="mk_instance_id" required="1"/>
                            </group>
                            <group>
                                <field name="code" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="woocommerce_payment_gateway_search_view" model="ir.ui.view">
            <field name="name">woocommerce_payment_gateway_search_view</field>
            <field name="model">woo.payment.gateway.ts</field>
            <field name="arch" type="xml">
                <search string="WooCommerce Payment Gateway">
                    <field name="name"/>
                    <field name="code"/>
                    <separator/>

                    <group>
                        <filter string="Instance" name="group_by_instance" context="{'group_by': 'mk_instance_id'}"/>
                    </group>

                    <searchpanel>
                        <field name="mk_instance_id" icon="fa-shopping-bag"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="woocommerce_payment_gateway_tree_view" model="ir.ui.view">
            <field name="name">woocommerce_payment_gateway_tree_view</field>
            <field name="model">woo.payment.gateway.ts</field>
            <field name="arch" type="xml">
                <list string="WooCommerce Payment Gateway" editable="bottom">
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="mk_instance_id" required="1" options="{'no_create_edit':1, 'no_create': True}"/>
                </list>
            </field>
        </record>

        <record id="action_woocommerce_payment_gateway" model="ir.actions.act_window">
            <field name="name">Payment Gateway</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">woo.payment.gateway.ts</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>